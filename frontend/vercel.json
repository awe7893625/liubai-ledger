{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/.*",
      "headers": {
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/shortcuts/(.*)\\.shortcut",
      "headers": {
        "Content-Type": "application/octet-stream",
        "Content-Disposition": "attachment",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/api/v2/preferences",
      "dest": "/api/v2/bootstrap?resource=preferences"
    },
    {
      "src": "/api/v2/planning",
      "dest": "/api/v2/bootstrap?resource=planning"
    },
    {
      "src": "/api/v2/budgets",
      "dest": "/api/v2/bootstrap?resource=budgets"
    },
    {
      "src": "/api/v2/categories",
      "dest": "/api/v2/bootstrap?resource=categories"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/not-an-api.json",
      "status": 404,
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/(?!api(?:/|$)|@vite(?:/|$)|@react-refresh$|@id(?:/|$)|@fs(?:/|$)|src(?:/|$)|node_modules(?:/|$)|assets(?:/|$)).*",
      "dest": "/index.html"
    }
  ]
}
