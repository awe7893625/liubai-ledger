# Ledger by 留白工作室 — copy to .env and change secrets before exposing the API.
APP_ENV=development
APP_TIMEZONE=Asia/Taipei
DATABASE_URL=sqlite:///./backend/data/ledger.db

# Apple Pay / iOS Shortcuts ingestion
# Generate a long random value. Shortcuts sends it as X-Ledger-Token.
LEDGER_INGEST_TOKEN=change-me-before-exposing
LEDGER_STORE_LOCATION=false
LEDGER_WALLET_DEBUG=false
LEDGER_DEBUG_VALIDATION=false

# Frontend / CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local AI
LEDGER_OLLAMA_BASE=http://127.0.0.1:11434
LEDGER_OLLAMA_MODEL=
LEDGER_OLLAMA_VISION_MODEL=

# Optional cloud AI fallback (never commit the real key)
OPENROUTER_API_KEY=
LEDGER_AI_OR_MODEL=
LEDGER_AI_VISION_OR_MODEL=
